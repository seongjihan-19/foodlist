# Supabase 연결 정보 (선택 사항: 이 파일 없이 앱 첫 화면에서 입력해도 된다)
# 이 파일을 복사해 .env.local로 저장하고 값을 채운다 (.env.local은 git에 올라가지 않음)
# = 뒤에 띄어쓰기 · 따옴표 없이 붙여 넣는다. 고친 뒤에는 앱을 다시 실행해야 반영된다

# Project URL — Project Settings → Data API (https://로 시작)
VITE_SUPABASE_URL=

# anon 키 — Project Settings → API Keys → Legacy API keys 탭의 anon public (eyJ로 시작)
# 상품 조회에 쓴다. 공개돼도 되는 키라 RLS의 읽기 정책 안에서만 동작한다
VITE_SUPABASE_ANON_KEY=

# service_role 키 — 같은 탭의 service_role (eyJ로 시작, Reveal을 눌러 복사)
# 상품 추가 · 삭제에 쓴다. 비우면 조회만 되는 읽기 전용으로 열린다
# 주의: RLS를 무시하고 DB 전체를 읽고 쓸 수 있는 키. 절대 공유 · 업로드 · 배포하지 않는다
VITE_SUPABASE_SERVICE_ROLE_KEY=

# 참고: Session pooler 같은 DB 연결 문자열(postgresql://...)은 이 앱에서 쓰지 않는다
